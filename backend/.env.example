# Optional API Keys - if omitted, robust fallback data feeds will be automatically used
ALPHA_VANTAGE_API_KEY=demo
NEWS_API_KEY=

# Database configuration (defaults to local SQLite database)
DATABASE_URL=sqlite:///./stock_prediction.db

# Model configuration
LOOKBACK_WINDOW=60
LSTM_EPOCHS=25
LSTM_BATCH_SIZE=16
FINBERT_MODEL=ProsusAI/finbert
